# Application Environment Configuration
NODE_ENV=development
PORT=4000
CLIENT_PORT=5173

# Database Connection
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/bidflow?schema=public"

# JWT Authentication
JWT_SECRET="bidflow-ultra-secure-jwt-secret-key-cse-2026-btech-token"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# Anti-Sniping Policy
ANTI_SNIPE_TRIGGER_SECONDS=30
ANTI_SNIPE_EXTEND_SECONDS=120

# Auction Worker Polling Interval (in milliseconds)
CLOSURE_WORKER_INTERVAL_MS=10000
