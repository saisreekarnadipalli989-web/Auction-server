datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum ListingCategory {
  TEXTBOOKS
  ELECTRONICS
  LAB_EQUIPMENT
  CALCULATORS
  FURNITURE
  OTHER
}

enum ListingCondition {
  BRAND_NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  CLOSED_WITH_WINNER
  CLOSED_WITHOUT_BIDS
  CANCELLED
  SUSPENDED
}

enum BidStatus {
  ACCEPTED
  REJECTED
  RETRACTED
}

enum NotificationType {
  OUTBID
  AUCTION_WON
  AUCTION_CLOSED
  AUCTION_EXTENDED
  LISTING_MODERATED
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  MISLEADING
  COUNTERFEIT
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         UserRole  @default(BUYER)
  avatarUrl    String?
  bio          String?
  isSuspended  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  listings        Listing[]
  bids            Bid[]
  leadingAuctions Auction[]        @relation("HighestBidder")
  watchlists      Watchlist[]
  notifications   Notification[]
  auditLogs       AuditLog[]       @relation("ActorAuditLogs")
  reportsFiled    ListingReport[]  @relation("ReporterUser")
  reportsReviewed ListingReport[]  @relation("ReviewerUser")
  feedbackGiven   SellerFeedback[] @relation("ReviewerFeedback")
  feedbackReceived SellerFeedback[] @relation("SellerFeedback")
  idempotencyRecords IdempotencyRecord[]

  @@index([role])
  @@index([isSuspended])
}

model Listing {
  id            String           @id @default(uuid())
  sellerId      String
  seller        User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title         String
  description   String
  category      ListingCategory
  condition     ListingCondition
  startingPrice Decimal          @db.Decimal(12, 2)
  minIncrement  Decimal          @default(1.00) @db.Decimal(12, 2)
  reservePrice  Decimal?         @db.Decimal(12, 2)
  status        ListingStatus    @default(PUBLISHED)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  images  ListingImage[]
  auction Auction?
  reports ListingReport[]

  @@index([sellerId])
  @@index([category, status])
  @@index([status, createdAt])
}

model ListingImage {
  id           String   @id @default(uuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url          String
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([listingId])
}

model Auction {
  id                       String        @id @default(uuid())
  listingId                String        @unique
  listing                  Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startTime                DateTime
  endTime                  DateTime
  originalEndTime          DateTime
  currentHighestBid        Decimal?      @db.Decimal(12, 2)
  currentHighestBidderId   String?
  currentHighestBidder     User?         @relation("HighestBidder", fields: [currentHighestBidderId], references: [id])
  bidCount                 Int           @default(0)
  status                   AuctionStatus @default(SCHEDULED)
  extensionCount           Int           @default(0)
  antiSnipeTriggerSeconds  Int           @default(30)
  antiSnipeExtendSeconds   Int           @default(120)
  closedAt                 DateTime?
  winningBidId             String?       @unique
  winningBid               Bid?          @relation("WinningBid", fields: [winningBidId], references: [id])
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  bids            Bid[]            @relation("AuctionBids")
  watchlists      Watchlist[]
  sellerFeedback  SellerFeedback?

  @@index([status, endTime])
  @@index([startTime, status])
  @@index([currentHighestBidderId])
}

model Bid {
  id              String    @id @default(uuid())
  auctionId       String
  auction         Auction   @relation("AuctionBids", fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId        String
  bidder          User      @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  amount          Decimal   @db.Decimal(12, 2)
  status          BidStatus @default(ACCEPTED)
  rejectionReason String?
  idempotencyKey  String?
  createdAt       DateTime  @default(now())

  wonAuction Auction? @relation("WinningBid")

  @@index([auctionId, amount(sort: Desc)])
  @@index([auctionId, createdAt(sort: Desc)])
  @@index([bidderId, createdAt(sort: Desc)])
  @@index([idempotencyKey])
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, auctionId])
  @@index([userId])
  @@index([auctionId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  payload    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
}

model IdempotencyRecord {
  key            String            @id
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  action         String
  requestHash    String
  status         IdempotencyStatus @default(PENDING)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime          @default(now())
  expiresAt      DateTime

  @@index([userId, key])
  @@index([expiresAt])
}

model ListingReport {
  id              String       @id @default(uuid())
  reporterId      String
  reporter        User         @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  listingId       String
  listing         Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reason          ReportReason
  details         String?
  status          ReportStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?        @relation("ReviewerUser", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime     @default(now())

  @@index([status, createdAt])
  @@index([listingId])
  @@index([reporterId])
}

model SellerFeedback {
  id         String   @id @default(uuid())
  auctionId  String   @unique
  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation("ReviewerFeedback", fields: [reviewerId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     User     @relation("SellerFeedback", fields: [sellerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([sellerId])
}
